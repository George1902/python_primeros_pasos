"""Una empresa evalúa su trimestre con base en:

Ingresos totales
Gastos totales
Número de nuevos clientes
Clasificación:

Si ingresos - gastos > $10,000 y más de 50 nuevos clientes → "Trimestre Excelente"
Si ingresos - gastos > $5,000 y al menos 20 clientes → "Trimestre Bueno"
Si ingresos - gastos > 0 → "Trimestre Regular"
Si ingresos - gastos ≤ 0 → "Trimestre Deficitario""""


ingresos_totales = float(input('Indique los ingresos totales: '))
gastos_totales = float(input('Indique los gastos totales: '))
numero_nuevos_clientes = int(input('Indique la cantidad de nuevos clientes: '))
ganancia_neta = ingresos_totales-gastos_totales

if ganancia_neta > 100000 and numero_nuevos_clientes >= 50:
    print('Trimestre excelente')
elif ganancia_neta > 5000 and numero_nuevos_clientes >= 20:
    print('Trimestre bueno')
elif ganancia_neta > 0:
    print('Timestre regular')
else:
    print('Trimestre Deficitiario')
